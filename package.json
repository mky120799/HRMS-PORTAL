{
  "name": "hrms-saas",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run start:dev -w @hrms/server",
    "dev:web": "npm run dev -w @hrms/web",
    "dev": "npx concurrently -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck -w @hrms/server && npm run typecheck -w @hrms/web",
    "test": "npm test -w @hrms/server",
    "test:e2e:api": "npm run test:e2e -w @hrms/server",
    "test:e2e:ui": "npm test -w @hrms/e2e",
    "db:migrate": "npm run prisma:migrate -w @hrms/server",
    "db:deploy": "npm run prisma:deploy -w @hrms/server",
    "db:seed": "npm run prisma -w @hrms/server -- db seed"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
