# Values for docker-compose.prod.yml (single-host deployment).
DOMAIN=hr.example.com

POSTGRES_PASSWORD=          # openssl rand -hex 24
RABBITMQ_PASSWORD=          # openssl rand -hex 24
REDIS_PASSWORD=             # openssl rand -hex 24   (shared rate-limit counters)
JWT_SECRET=                 # openssl rand -hex 32
ENCRYPTION_KEY=             # openssl rand -base64 32   (losing this makes 2FA secrets/webhooks unreadable)
FRONTEND_URL=https://hr.example.com
API_PUBLIC_URL=https://api.hr.example.com
CORS_ORIGINS=https://hr.example.com
OIDC_CALLBACK_URL=https://api.hr.example.com/api/v1/auth/oidc/callback
PUBLIC_SIGNUP_ENABLED=false

AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=         # private bucket, SSE enabled
AWS_ACCESS_KEY_ID=          # IAM user limited to that bucket + SES SendEmail
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM="HRMS <noreply@example.com>"   # domain verified in SES (with DKIM)
EMAIL_WEBHOOK_SECRET=       # openssl rand -hex 32; used by signed SES event callbacks
NOTIFICATION_HISTORY_RETENTION_DAYS=365
NOTIFICATION_COMPLETED_OUTBOX_RETENTION_DAYS=30
NOTIFICATION_RETENTION_CLEANUP_INTERVAL_HOURS=24

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=
SENTRY_DSN=
