# Values for docker-compose.prod.yml (single-host deployment).
DOMAIN=hr.example.com

POSTGRES_PASSWORD=          # openssl rand -hex 24
RABBITMQ_PASSWORD=          # openssl rand -hex 24
JWT_SECRET=                 # openssl rand -hex 32
ENCRYPTION_KEY=             # openssl rand -base64 32   (losing this makes 2FA secrets/webhooks unreadable)

AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=         # private bucket, SSE enabled
AWS_ACCESS_KEY_ID=          # IAM user limited to that bucket + SES SendEmail
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM="HRMS <noreply@example.com>"   # domain verified in SES (with DKIM)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=
SENTRY_DSN=
