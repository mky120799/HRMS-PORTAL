generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Conventions
// - Every business table carries `tenantId` and is indexed on it. Services must
//   always filter by the tenantId taken from the verified access token.
// - Money is stored as DECIMAL(12,2) — never floating point.
// - Status/role columns are strings validated at the API boundary (see
//   src/common/constants/domain.ts); the allowed values are listed inline.
// ─────────────────────────────────────────────────────────────────────────────

enum SubscriptionPlan {
  FREE
  BASIC
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

model Tenant {
  id                    String             @id @default(uuid())
  name                  String
  slug                  String             @unique
  timezone              String             @default("UTC") // IANA zone, drives attendance "today" and payroll periods
  isActive              Boolean            @default(true) // false = suspended by platform operator
  whitelistedIps        String[]           @default([]) // IPv4 addresses or CIDR ranges; empty = allow all
  slackWebhookUrlEnc    String? // AES-256-GCM encrypted (see CryptoService)
  slackHiringWebhookEnc String?
  demoSeededAt          DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  stripeCustomerId      String?            @unique
  stripeSubscriptionId  String?            @unique
  subscriptionStatus    SubscriptionStatus @default(TRIAL)
  subscriptionPlan      SubscriptionPlan   @default(FREE)
  trialEndsAt           DateTime?

  users                          User[]
  employees                      Employee[]
  jobs                           Job[]
  applications                   Application[]
  hiringStages                   HiringStage[]
  applicationEvents              ApplicationEvent[]
  interviewFeedback              InterviewFeedback[]
  hiringOutboxEvents             HiringOutboxEvent[]
  assessmentIntegrations         AssessmentIntegration[]
  assessmentRequests             AssessmentRequest[]
  leaves                         LeaveRequest[]
  leaveBalanceLedger             LeaveBalanceLedger[]
  leavePolicies                  LeavePolicy[]
  leavePolicyVersions            LeavePolicyVersion[]
  leaveApprovalRules             LeaveApprovalRule[]
  leaveApprovalDelegations       LeaveApprovalDelegation[]
  leaveApprovalFollowUps         LeaveApprovalFollowUp[]
  holidays                       Holiday[]
  notifications                  Notification[]
  notificationEvents             NotificationEvent[]
  notificationOutboxEvents       NotificationOutboxEvent[]
  notificationPreferences        NotificationPreference[]
  notificationDeliverySettings   NotificationDeliverySetting[]
  notificationDigestItems        NotificationDigestItem[]
  notificationSuppressions       NotificationSuppression[]
  notificationWebhookEvents      NotificationWebhookEvent[]
  notificationTemplates          NotificationTemplate[]
  notificationCampaigns          NotificationCampaign[]
  notificationCampaignRecipients NotificationCampaignRecipient[]
  attendance                     AttendanceRecord[]
  salaryStructures               SalaryStructure[]
  payslips                       Payslip[]
  documents                      Document[]
  performanceReviews             PerformanceReview[]
}

model User {
  id                  String    @id @default(uuid())
  tenantId            String
  email               String // always stored lower-case
  passwordHash        String // empty string for SSO-only users (can never match bcrypt)
  name                String
  role                String    @default("EMPLOYEE") // SUPER_ADMIN, ADMIN, MANAGER, EMPLOYEE
  isActive            Boolean   @default(true)
  tokenVersion        Int       @default(0) // bump to revoke every outstanding refresh/invite/reset token
  refreshToken        String? // bcrypt hash of the current refresh token (one session per user)
  refreshTokenExpiry  DateTime?
  twoFactorSecret     String? // AES-256-GCM encrypted TOTP secret
  isTwoFactorEnabled  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant              Tenant                    @relation(fields: [tenantId], references: [id])
  employee            Employee?
  applicationEvents   ApplicationEvent[]        @relation("ApplicationEventActor")
  interviewFeedback   InterviewFeedback[]
  delegatedApprovals  LeaveApprovalDelegation[] @relation("Delegate")
  approvalDelegations LeaveApprovalDelegation[] @relation("Delegator")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model Employee {
  id             String    @id @default(uuid())
  tenantId       String
  userId         String?   @unique
  employeeCode   String?
  email          String
  firstName      String
  lastName       String
  phone          String?
  department     String?
  designation    String?
  managerId      String?
  employmentType String    @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERN
  status         String    @default("ACTIVE") // ACTIVE, ON_NOTICE, EXITED
  dateOfJoining  DateTime? @db.Date
  exitDate       DateTime? @db.Date
  anonymizedAt   DateTime? // set when PII is erased (data-protection request)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  user               User?                @relation(fields: [userId], references: [id])
  manager            Employee?            @relation("Reports", fields: [managerId], references: [id])
  reports            Employee[]           @relation("Reports")
  leaves             LeaveRequest[]
  leaveBalanceLedger LeaveBalanceLedger[]
  attendance         AttendanceRecord[]
  salaryStructure    SalaryStructure?
  payslips           Payslip[]
  documents          Document[]
  performanceReviews PerformanceReview[]  @relation("EmployeeReviews")
  managerReviews     PerformanceReview[]  @relation("ManagerReviews")

  @@unique([tenantId, email])
  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([managerId])
}

model LeavePolicy {
  id                String    @id @default(uuid())
  tenantId          String
  type              String // ANNUAL, SICK, CASUAL, UNPAID, ...
  annualQuota       Int // working days per calendar year; ignored when isPaid = false
  isPaid            Boolean   @default(true)
  accrualMode       String    @default("ANNUAL_GRANT") // ANNUAL_GRANT, MONTHLY, PER_PAY_PERIOD
  carryForwardLimit Decimal?  @db.Decimal(8, 2)
  allowNegative     Boolean   @default(false)
  effectiveFrom     DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  effectiveTo       DateTime? @db.Date
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  versions LeavePolicyVersion[]

  @@unique([tenantId, type])
}

/// Immutable configuration history. New entitlement terms take effect only in
/// a new version; submitted requests retain their policy snapshot.
model LeavePolicyVersion {
  id                String    @id @default(uuid())
  tenantId          String
  leavePolicyId     String
  version           Int
  annualQuota       Int
  isPaid            Boolean
  accrualMode       String
  carryForwardLimit Decimal?  @db.Decimal(8, 2)
  allowNegative     Boolean   @default(false)
  effectiveFrom     DateTime  @db.Date
  effectiveTo       DateTime? @db.Date
  createdAt         DateTime  @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  leavePolicy LeavePolicy @relation(fields: [leavePolicyId], references: [id])

  @@unique([leavePolicyId, version])
  @@index([tenantId, leavePolicyId, effectiveFrom])
}

/// A tenant can route each leave type through direct managers, a role, or an
/// explicitly named user. Rules are snapshotted on request submission.
model LeaveApprovalRule {
  id                   String   @id @default(uuid())
  tenantId             String
  type                 String
  step                 Int
  approverKind         String // DIRECT_MANAGER, ROLE, SPECIFIC_USER
  approverRole         String?
  approverUserId       String?
  reminderAfterHours   Int      @default(24)
  escalationAfterHours Int?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type, step])
  @@index([tenantId, type, isActive])
}

/// A time-bounded substitute for a particular approver. Delegation is checked
/// at approval time; it never changes the workflow snapshot on the request.
model LeaveApprovalDelegation {
  id          String    @id @default(uuid())
  tenantId    String
  delegatorId String
  delegateId  String
  startsAt    DateTime  @db.Date
  endsAt      DateTime? @db.Date
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  delegator User   @relation("Delegator", fields: [delegatorId], references: [id])
  delegate  User   @relation("Delegate", fields: [delegateId], references: [id])

  @@unique([tenantId, delegatorId, delegateId, startsAt], map: "LeaveApprovalDelegation_tenantId_delegatorId_delegateId_startsA")
  @@index([tenantId, delegateId, startsAt])
}

/// Prevents duplicate reminder/escalation delivery when the scheduler retries.
model LeaveApprovalFollowUp {
  id             String   @id @default(uuid())
  tenantId       String
  leaveRequestId String
  step           Int
  kind           String // REMINDER, ESCALATION
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id])

  @@unique([leaveRequestId, step, kind])
  @@index([tenantId, createdAt])
}

model Holiday {
  id       String   @id @default(uuid())
  tenantId String
  date     DateTime @db.Date
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date])
}

model LeaveRequest {
  id                String                  @id @default(uuid())
  tenantId          String
  employeeId        String
  type              String
  startDate         DateTime
  endDate           DateTime
  days              Int                     @default(0) // working days (excludes weekends and tenant holidays)
  requestKey        String? // caller-provided idempotency key
  policySnapshot    Json? // immutable policy used when this request was submitted
  approvalSnapshot  Json? // immutable approver-routing rules used at submission
  approvalFollowUps LeaveApprovalFollowUp[]
  reason            String?
  status            String                  @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  reviewedById      String? // User id of the approver
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  employee      Employee             @relation(fields: [employeeId], references: [id])
  ledgerEntries LeaveBalanceLedger[]
  approvals     LeaveApproval[]

  @@unique([tenantId, requestKey])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

/// Immutable leave entitlement events. Positive days increase availability;
/// reservations and consumption reduce it. Never update an event: append a
/// compensating event instead, so balances remain explainable and auditable.
model LeaveBalanceLedger {
  id             String   @id @default(uuid())
  tenantId       String
  employeeId     String
  leaveRequestId String?
  type           String
  year           Int
  event          String // OPENING_BALANCE, RESERVATION, RELEASE, CONSUMPTION, ADJUSTMENT
  eventKey       String // unique, idempotent event identifier
  days           Decimal  @db.Decimal(8, 2)
  metadata       Json?
  createdAt      DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  employee     Employee      @relation(fields: [employeeId], references: [id])
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id])

  @@unique([tenantId, employeeId, type, year, eventKey])
  @@index([tenantId, employeeId, type, year])
  @@index([leaveRequestId])
}

/// Decision history is retained independently from the request's current
/// status. It supports future multi-step/delegated approval workflows.
model LeaveApproval {
  id             String   @id @default(uuid())
  tenantId       String
  leaveRequestId String
  step           Int      @default(1)
  approverId     String
  decision       String // APPROVED, REJECTED, CANCELLED
  note           String?
  actedAt        DateTime @default(now())

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id])

  @@unique([leaveRequestId, step])
  @@index([tenantId, leaveRequestId])
}

model Job {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String
  department  String
  location    String?
  status      String   @default("OPEN") // OPEN, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  applications Application[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model Application {
  id                       String    @id @default(uuid())
  tenantId                 String
  jobId                    String
  stageId                  String?
  candidateName            String
  candidateEmail           String
  resumeUrl                String? // legacy, unused
  resumeFilename           String? // original filename, display only
  resumeKey                String? // object-storage key (private)
  resumeMimeType           String?
  source                   String    @default("CAREERS_SITE") // CAREERS_SITE | LINKEDIN | INDEED | REFERRAL | OTHER
  aiScore                  Int? // advisory match score 0-100, never used to auto-reject
  aiReason                 String?
  aiScoredAt               DateTime?
  status                   String    @default("APPLIED") // APPLIED, SCREENING, INTERVIEW, OFFERED, HIRED, REJECTED
  interviewAt              DateTime?
  interviewerEmail         String?
  interviewDurationMinutes Int?
  interviewLocation        String?
  interviewScheduleVersion Int       @default(0)
  interviewReminderSentAt  DateTime? // set atomically when reminder outbox records are queued
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  job                Job                 @relation(fields: [jobId], references: [id])
  stage              HiringStage?        @relation(fields: [stageId], references: [id])
  assessmentRequests AssessmentRequest[]
  events             ApplicationEvent[]
  feedback           InterviewFeedback[]
  outboxEvents       HiringOutboxEvent[]

  @@unique([jobId, candidateEmail])
  @@index([jobId])
  @@index([tenantId, status])
  @@index([tenantId, stageId])
  @@index([tenantId, interviewAt]) // used by the lifecycle-aware reminder scheduler
}

/// Tenant-configurable stage within the recruiting pipeline. `category`
/// preserves compatibility with the application status used by existing APIs.
model HiringStage {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  name      String
  category  String // APPLIED, SCREENING, INTERVIEW, OFFERED, HIRED, REJECTED
  position  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  applications Application[]

  @@unique([tenantId, key])
  @@index([tenantId, isActive, position])
}

/// Immutable application history for recruiter actions, system events, and
/// provider results. It is the source for the recruiter-facing timeline.
model ApplicationEvent {
  id            String   @id @default(uuid())
  tenantId      String
  applicationId String
  actorUserId   String?
  type          String
  note          String?
  metadata      Json?
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
  actor       User?       @relation("ApplicationEventActor", fields: [actorUserId], references: [id])

  @@index([tenantId, applicationId, createdAt])
}

/// Per-tenant connection metadata for a specialist assessment vendor. The
/// shared webhook secret is encrypted at rest and is only revealed on rotation.
model AssessmentIntegration {
  id               String   @id @default(uuid())
  tenantId         String
  provider         String // stable provider key, e.g. HACKERRANK or TESTGORILLA
  displayName      String
  webhookSecretEnc String
  isActive         Boolean  @default(true)
  config           Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant   Tenant                   @relation(fields: [tenantId], references: [id])
  requests AssessmentRequest[]
  events   AssessmentWebhookEvent[]

  @@unique([tenantId, provider])
  @@index([tenantId, isActive])
}

/// A vendor-hosted test linked to an application. The vendor owns the test;
/// HRMS stores only the normalized lifecycle and optional result/report link.
model AssessmentRequest {
  id             String    @id @default(uuid())
  tenantId       String
  applicationId  String
  integrationId  String
  externalId     String?
  status         String    @default("PENDING") // PENDING, COMPLETED, FAILED, EXPIRED
  assessmentUrl  String?
  score          Decimal?  @db.Decimal(5, 2)
  recommendation String?
  reportUrl      String?
  requestedAt    DateTime  @default(now())
  completedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  application Application           @relation(fields: [applicationId], references: [id])
  integration AssessmentIntegration @relation(fields: [integrationId], references: [id])

  @@unique([integrationId, externalId])
  @@index([tenantId, applicationId, status])
  @@index([integrationId, status])
}

/// Idempotency fence for vendor webhook deliveries. No raw candidate result is
/// retained here; AssessmentRequest stores the normalized result only.
model AssessmentWebhookEvent {
  id              String   @id @default(uuid())
  integrationId   String
  providerEventId String
  receivedAt      DateTime @default(now())

  integration AssessmentIntegration @relation(fields: [integrationId], references: [id])

  @@unique([integrationId, providerEventId])
}

/// Structured feedback left by an interviewer after an interview.
/// One record per interviewer per application (upsert on re-submission).
model InterviewFeedback {
  id             String   @id @default(uuid())
  tenantId       String
  applicationId  String
  authorUserId   String
  rating         Int // 1 (poor) – 5 (excellent)
  recommendation String // STRONG_YES | YES | NEUTRAL | NO | STRONG_NO
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
  author      User        @relation(fields: [authorUserId], references: [id])

  @@unique([applicationId, authorUserId])
  @@index([tenantId, applicationId])
}

/// Durable side effects created in the same transaction as a hiring mutation.
/// A leased dispatcher delivers email, RabbitMQ, and Slack work with retries.
model HiringOutboxEvent {
  id            String    @id @default(uuid())
  tenantId      String
  applicationId String?
  eventKey      String
  type          String // EMAIL, HIRING_QUEUE, SLACK_NEW_APPLICATION
  payload       Json
  status        String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now())
  lockedAt      DateTime?
  lastError     String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id])

  @@unique([tenantId, eventKey])
  @@index([status, availableAt])
  @@index([tenantId, applicationId])
}

model Notification {
  id              String    @id @default(uuid())
  tenantId        String
  eventId         String?
  eventType       String?
  category        String    @default("GENERAL")
  channel         String // EMAIL, IN_APP
  title           String
  body            String // credential-bearing emails are stored redacted
  status          String    @default("PENDING") // PENDING, QUEUED, PROCESSING, SENT, DELIVERED, FAILED, READ, SUPPRESSED, BOUNCED, COMPLAINED, REJECTED
  recipientUserId String?
  recipientEmail  String?
  subject         String?
  idempotencyKey  String?
  metadata        Json?
  error           String?
  processingAt    DateTime?
  sentAt          DateTime?
  readAt          DateTime?
  archivedAt      DateTime?
  link            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant             @relation(fields: [tenantId], references: [id])
  event  NotificationEvent? @relation(fields: [eventId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, recipientUserId])
  @@index([tenantId, recipientUserId, readAt, archivedAt])
  @@index([eventId])
}

/// One business occurrence, independent of how it is delivered. For example,
/// a LEAVE_APPROVED event can create both IN_APP and EMAIL notifications.
model NotificationEvent {
  id          String   @id @default(uuid())
  tenantId    String
  eventKey    String
  eventType   String
  category    String   @default("GENERAL")
  actorUserId String?
  data        Json
  createdAt   DateTime @default(now())

  tenant        Tenant                    @relation(fields: [tenantId], references: [id])
  notifications Notification[]
  outboxEvents  NotificationOutboxEvent[]

  @@unique([tenantId, eventKey])
  @@index([tenantId, eventType, createdAt])
}

/// Transactional hand-off from PostgreSQL to RabbitMQ. Rows are leased so
/// multiple API instances can drain the same table without double ownership.
model NotificationOutboxEvent {
  id                  String    @id @default(uuid())
  tenantId            String
  notificationEventId String
  eventKey            String
  type                String // EMAIL (additional channel adapters can be added later)
  payload             Json
  encryptedPayload    String? // AES-256-GCM payload for credential-bearing messages
  status              String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  attempts            Int       @default(0)
  availableAt         DateTime  @default(now())
  lockedAt            DateTime?
  lastError           String?
  processedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  notificationEvent NotificationEvent @relation(fields: [notificationEventId], references: [id])

  @@unique([tenantId, eventKey])
  @@index([status, availableAt])
  @@index([tenantId, notificationEventId])
}

/// Per-user channel choice. Missing rows mean the channel is enabled. Events
/// marked mandatory by the publisher ignore opt-outs (security/compliance).
model NotificationPreference {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  eventType String   @default("*")
  channel   String // IN_APP, EMAIL, SLACK
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, userId, eventType, channel])
  @@index([tenantId, userId])
}

/// Per-user delivery controls that affect email timing. Preferences still decide
/// whether a channel is enabled; this model decides when enabled email is sent.
model NotificationDeliverySetting {
  id                String    @id @default(uuid())
  tenantId          String
  userId            String
  timezone          String    @default("UTC")
  quietHoursEnabled Boolean   @default(false)
  quietStartMinutes Int?
  quietEndMinutes   Int?
  digestFrequency   String    @default("IMMEDIATE") // IMMEDIATE, DAILY, WEEKLY
  digestHour        Int       @default(9)
  digestDayOfWeek   Int       @default(1) // 0 Sunday ... 6 Saturday
  lastDigestSentAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId, userId])
}

/// Email work held for a daily or weekly digest instead of being delivered as an
/// individual message. Digest rows are created transactionally with the source
/// notification event and are idempotent on `(tenantId, digestKey)`.
model NotificationDigestItem {
  id             String    @id @default(uuid())
  tenantId       String
  userId         String
  email          String
  digestKey      String
  eventType      String
  category       String    @default("GENERAL")
  title          String
  body           String
  link           String?
  status         String    @default("PENDING") // PENDING, QUEUED, SENT, FAILED
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  notificationId String?
  error          String?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, digestKey])
  @@index([tenantId, userId, status, availableAt])
  @@index([status, availableAt])
}

/// Stops optional email to addresses that bounced or complained. Mandatory
/// security/compliance mail may still bypass this when explicitly published.
model NotificationSuppression {
  id         String    @id @default(uuid())
  tenantId   String
  email      String
  reason     String // BOUNCE, COMPLAINT, MANUAL
  source     String    @default("SES")
  active     Boolean   @default(true)
  count      Int       @default(1)
  lastEventAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId, active, reason])
}

/// Idempotency fence for email provider callbacks. Raw provider payloads are not
/// stored; the event id/type and normalized outcome are enough for replay safety.
model NotificationWebhookEvent {
  id             String   @id
  tenantId       String?
  notificationId String?
  email          String?
  provider       String   @default("SES")
  eventType      String
  status         String
  receivedAt     DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, receivedAt])
  @@index([notificationId])
}

/// Tenant-customizable email template versions. If an active template exists
/// for `(tenantId, eventType, channel)`, it overrides the code default.
model NotificationTemplate {
  id              String   @id @default(uuid())
  tenantId        String
  eventType       String
  channel         String   @default("EMAIL")
  version         Int
  subjectTemplate String
  htmlTemplate    String
  textTemplate    String
  isActive        Boolean  @default(false)
  createdByUserId String?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eventType, channel, version])
  @@index([tenantId, eventType, channel, isActive])
}

/// An administrator announcement. Audience membership is snapshotted into
/// recipient rows so later department changes do not alter a scheduled send.
model NotificationCampaign {
  id                  String    @id @default(uuid())
  tenantId            String
  createdByUserId     String
  subject             String
  body                String
  audience            Json
  status              String    @default("SCHEDULED") // SCHEDULED, PROCESSING, COMPLETED, CANCELLED
  scheduledAt         DateTime  @default(now())
  lockedAt            DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  totalRecipients     Int       @default(0)
  processedRecipients Int       @default(0)
  failedRecipients    Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant     Tenant                          @relation(fields: [tenantId], references: [id])
  recipients NotificationCampaignRecipient[]

  @@index([tenantId, createdAt])
  @@index([status, scheduledAt, lockedAt])
}

model NotificationCampaignRecipient {
  id          String    @id @default(uuid())
  tenantId    String
  campaignId  String
  employeeId  String
  userId      String?
  email       String
  status      String    @default("PENDING") // PENDING, QUEUED, FAILED
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  campaign NotificationCampaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, email])
  @@index([tenantId, campaignId, status, availableAt])
}

model AttendanceRecord {
  id          String    @id @default(uuid())
  tenantId    String
  employeeId  String
  date        DateTime  @db.Date // calendar date in the tenant's timezone
  clockIn     DateTime
  clockOut    DateTime?
  workMinutes Int?
  status      String    @default("PRESENT") // PRESENT, HALF_DAY, ABSENT
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([tenantId])
  @@index([tenantId, date])
}

/// All amounts are MONTHLY.
model SalaryStructure {
  id         String   @id @default(uuid())
  tenantId   String
  employeeId String   @unique
  baseSalary Decimal  @db.Decimal(12, 2) // monthly basic
  allowances Decimal  @default(0) @db.Decimal(12, 2) // monthly fixed allowances
  deductions Decimal  @default(0) @db.Decimal(12, 2) // other fixed monthly deductions
  monthlyTds Decimal  @default(0) @db.Decimal(12, 2) // income-tax withholding from the employee's tax projection
  pfEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
}

model Payslip {
  id           String    @id @default(uuid())
  tenantId     String
  employeeId   String
  month        Int // 1-12
  year         Int
  payableDays  Decimal   @default(0) @db.Decimal(5, 1)
  lopDays      Decimal   @default(0) @db.Decimal(5, 1)
  basicPay     Decimal   @db.Decimal(12, 2)
  allowances   Decimal   @db.Decimal(12, 2)
  grossPay     Decimal   @default(0) @db.Decimal(12, 2)
  pfDeduction  Decimal   @default(0) @db.Decimal(12, 2)
  tdsDeduction Decimal   @default(0) @db.Decimal(12, 2)
  deductions   Decimal   @db.Decimal(12, 2) // total of all deductions
  netPay       Decimal   @db.Decimal(12, 2)
  status       String    @default("DRAFT") // DRAFT, FINALIZED
  finalizedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month, year])
  @@index([tenantId])
  @@index([tenantId, year, month])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String // CREATE, UPDATE, DELETE, LOGIN, EXPORT, ...
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, resource])
  @@index([tenantId, userId])
}

model Document {
  id           String    @id @default(uuid())
  tenantId     String
  employeeId   String
  title        String
  type         String    @default("OTHER") // ID, CONTRACT, POLICY, CERTIFICATE, OTHER
  fileUrl      String? // legacy, unused
  storageKey   String? // private object-storage key
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, expiryDate])
}

model PerformanceReview {
  id              String    @id @default(uuid())
  tenantId        String
  employeeId      String
  reviewerId      String? // Employee id of the manager who reviews
  cycleName       String
  selfRating      Int? // 1-5
  managerRating   Int? // 1-5
  selfComments    String?   @map("comments")
  managerComments String?
  status          String    @default("DRAFT") // DRAFT, SELF_SUBMITTED, COMPLETED
  submittedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  employee Employee  @relation("EmployeeReviews", fields: [employeeId], references: [id])
  reviewer Employee? @relation("ManagerReviews", fields: [reviewerId], references: [id])

  @@unique([tenantId, employeeId, cycleName])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([reviewerId])
}

/// Processed Stripe webhook events — makes webhook handling idempotent.
model StripeEvent {
  id          String   @id // Stripe event id (evt_...)
  type        String
  processedAt DateTime @default(now())
}
