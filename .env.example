# ─── Local development (apps/server reads this file) ──────────────────────────
# cp .env.example apps/server/.env   then adjust. Never commit real secrets.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL="postgresql://hrms:hrms@localhost:5432/hrms_db?schema=public"
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Shared rate-limit counters. Optional in development (in-memory when empty); required in production.
REDIS_URL=

# Generate real values: openssl rand -hex 32  /  openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0zMi1ieXRlcyE=

FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
PUBLIC_SIGNUP_ENABLED=true

# Local disk + log-only email for development. Production requires s3 + ses.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
EMAIL_DRIVER=log
EMAIL_FROM="HRMS <noreply@example.com>"
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=

# Optional integrations — features stay disabled when empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
OIDC_CALLBACK_URL=http://localhost:3000/api/v1/auth/oidc/callback
# Dev only: allow OIDC issuers on localhost/private networks (e.g. a local Keycloak). Refused in production.
ALLOW_PRIVATE_IDP_URLS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=
SENTRY_DSN=
